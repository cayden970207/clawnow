# Supabase (CreateNow auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# Hetzner
OCTOGEN_HETZNER_API_TOKEN=
OCTOGEN_HETZNER_LOCATION=sin
OCTOGEN_HETZNER_SERVER_TYPE=cpx31
OCTOGEN_HETZNER_IMAGE=ubuntu-22.04
# Optional: comma-separated SSH key names or IDs from your Hetzner account
OCTOGEN_HETZNER_SSH_KEYS=
OCTOGEN_VM_NAME_PREFIX=octogen
OCTOGEN_BOOTSTRAP_ASSET_BASE_URL=

# Gateway routing mode
# Default: per-instance HTTPS URL via sslip.io + Caddy on each VM
OCTOGEN_INSTANCE_GATEWAY_TEMPLATE=https://{{IPV4}}.sslip.io
# Temporary fallback (if sslip.io TLS issuance is rate-limited):
# OCTOGEN_INSTANCE_GATEWAY_TEMPLATE=http://{{IPV4}}:18790
OCTOGEN_CONTROL_UI_PATH=octogen
OCTOGEN_NOVNC_PATH=novnc

# Optional: shared gateway mode
OCTOGEN_GATEWAY_BASE_URL=
OCTOGEN_CONTROL_UI_BASE_URL=
OCTOGEN_NOVNC_BASE_URL=

# Trusted proxy signer
OCTOGEN_CONTROL_UI_ALLOWED_ORIGIN=
OCTOGEN_PROXY_SHARED_SECRET=
OCTOGEN_CONTROL_SESSION_TTL_SECONDS=300
OCTOGEN_NOVNC_TTL_MINUTES=30
# Optional: fixed console gateway device private key.
# If unset, a temporary key is generated at process boot.
# Recommended for stable pairing across redeploys:
# OCTOGEN_GATEWAY_DEVICE_PRIVATE_KEY_B64=$(base64 < /path/to/private-key.pem | tr -d '\n')
OCTOGEN_GATEWAY_DEVICE_PRIVATE_KEY_PEM=
OCTOGEN_GATEWAY_DEVICE_PRIVATE_KEY_B64=
# First-boot package install can be slow on fresh VMs.
OCTOGEN_PROVISIONING_TIMEOUT_SECONDS=900

# Optional VM cloud-init override
OCTOGEN_HETZNER_CLOUD_INIT=
# Default behavior (when empty): uses a compact cloud-init that pulls bootstrap scripts from openclaw main branch URLs.
# Supports placeholders: {{PROXY_SHARED_SECRET}} {{CONTROL_UI_PATH}} {{NOVNC_PATH}} {{USER_ID}} {{INSTANCE_ID}}
OCTOGEN_OPENCLAW_BOOTSTRAP_COMMAND=
# Optional: version passed to bootstrap --openclaw-version (defaults to latest).
# Examples:
# OCTOGEN_OPENCLAW_VERSION=latest
# OCTOGEN_OPENCLAW_VERSION=2026.3.1
# OCTOGEN_OPENCLAW_VERSION=github:openclaw/openclaw#main
OCTOGEN_OPENCLAW_VERSION=

# Legacy CLAWNOW_* names are still accepted for existing deployments.
